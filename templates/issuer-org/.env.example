# Umbra Issuer Organization — Environment Configuration

# ─── Organization ────────────────────────────────────────
ORG_NAME="My Organization"
ORG_TYPE="CLUB"                # DAO | CLUB | HOSPITAL | UNIVERSITY | CORP | COOPERATIVE | GOVERNMENT | OTHER
ORG_ID=""                      # Filled after registration (PolicyId)

# ─── Schemas ─────────────────────────────────────────────
# Comma-separated list of schemas this org will issue
SCHEMAS="soulbound:v1:membership"

# ─── Cardano ─────────────────────────────────────────────
BLOCKFROST_PROJECT_ID=""       # Get one at https://blockfrost.io
CARDANO_NETWORK="preprod"      # preprod | mainnet
REGISTRY_POLICY_ID=""          # Umbra Registry contract PolicyId
ADMIN_WALLET_PATH="./keys/admin.skey"

# ─── Midnight ────────────────────────────────────────────
MIDNIGHT_NODE_URL="http://localhost:9944"
MIDNIGHT_PROOF_SERVER_URL="http://localhost:6300"
MIDNIGHT_CONTRACT_ADDRESS=""   # Umbra Credential contract address

# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
